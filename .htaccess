# ----------------------------------------------------------------------
# Jade Light - Clean URLs (Apache mod_rewrite)
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirect /index.html to root /
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # 2. Redirect /Partners.html or /partners.html to lowercase /partners
    RewriteCond %{THE_REQUEST} \s/+[Pp]artners\.html(?:[\s?]) [NC]
    RewriteRule ^[Pp]artners\.html$ /partners [R=301,L]

    # 3. Redirect other direct HTML page requests to clean URLs
    RewriteCond %{THE_REQUEST} \s/+((?:about|contact|industries|solutions))\.html(?:[\s?]) [NC]
    RewriteRule ^(about|contact|industries|solutions)\.html$ /$1 [R=301,L,NC]

    # 4. Normalize uppercase Partners route (handles both /Partners and /Partners/)
    RewriteRule ^Partners/?$ /partners [R=301,L]

    # 5. Normalize trailing slash for non-directories (e.g. /about/ -> /about)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # 6. Allow existing files and directories (placed after external redirects, before internal rewrites)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [END]

    # 7. Special internal rewrite for /partners -> Partners.html
    RewriteRule ^partners/?$ Partners.html [END,NC]

    # 8. Internal rewrite for other clean URLs
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [END]
</IfModule>

# NOTE FOR HOSTING:
# If your server runs Apache < 2.4 and throws an HTTP 500 error due to [END],
# replace [END] in rules 6, 7, and 8 with [L].
